# ===================================================
# SWAG INC. VAMP 4 — ENVIRONMENT CONFIGURATION
# ===================================================

# Server Port
PORT=3001

# JWT Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_string

# Secret code required to register as the FOUNDER (@macansssssssssss1337)
FOUNDER_INVITE_CODE=swag_founder_master_key_777

# Google Gemini API Key for J.A.R.V.I.S. (kept strictly on server, never exposed with VITE_)
JARVIS_API_KEY=

# Gemini Model
JARVIS_MODEL=gemini-2.5-flash

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:4173
