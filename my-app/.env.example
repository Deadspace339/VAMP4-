# ===================================================
# J.A.R.V.I.S. AI CORE & API CONFIGURATION
# ===================================================

# --- LOCAL DEVELOPMENT ONLY ---
# API ключ используется ТОЛЬКО в dev режиме (npm run dev)
# В продакшене (Vercel) используйте серверную переменную JARVIS_API_KEY
VITE_JARVIS_API_KEY=

# Модель ИИ (для локальной разработки)
VITE_JARVIS_MODEL=gemini-2.5-flash

# --- VERCEL PRODUCTION (Environment Variables) ---
# Добавьте в Vercel Dashboard → Settings → Environment Variables:
# JARVIS_API_KEY=ваш_ключ (БЕЗ VITE_ префикса!)
# JARVIS_MODEL=gemini-2.5-flash
